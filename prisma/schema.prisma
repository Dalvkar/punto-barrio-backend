generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CashMovementType {
  INCOME
  EXPENSE
}

enum CreditStatus {
  PENDING
  PARTIAL
  PAID
}

model Product {
  id            Int            @id @default(autoincrement())
  name          String
  sku           String         @unique
  category      String
  price         Decimal        @db.Decimal(10, 2)
  cost          Decimal        @db.Decimal(10, 2)
  stock         Int            @default(0)
  minStock      Int            @default(5)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  creditItems   CreditItem[]
}

model Sale {
  id          Int        @id @default(autoincrement())
  receiptCode String     @unique
  customer    String?
  total       Decimal    @db.Decimal(10, 2)
  paymentType String
  createdAt   DateTime   @default(now())
  items       SaleItem[]
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model CashMovement {
  id          Int              @id @default(autoincrement())
  type        CashMovementType
  category    String
  description String
  amount      Decimal          @db.Decimal(10, 2)
  saleId      Int?
  createdAt   DateTime         @default(now())
}

model CashClosing {
  id             Int      @id @default(autoincrement())
  openingBalance Decimal  @db.Decimal(10, 2)
  expectedAmount Decimal  @db.Decimal(10, 2)
  actualAmount   Decimal  @db.Decimal(10, 2)
  difference     Decimal  @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime @default(now())
}

model Supplier {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  contactName String?
  phone       String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  purchases   Purchase[]
}

model Purchase {
  id            Int            @id @default(autoincrement())
  supplierId    Int
  invoiceNumber String?
  total         Decimal        @db.Decimal(10, 2)
  createdAt     DateTime       @default(now())
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  items         PurchaseItem[]

  @@unique([supplierId, invoiceNumber])
  @@index([createdAt])
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  productId  Int
  quantity   Int
  unitCost   Decimal  @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String?  @unique
  creditLimit Decimal  @default(500) @db.Decimal(10, 2)
  balance     Decimal  @default(0) @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  credits     Credit[]

  @@index([name])
}

model Credit {
  id         Int             @id @default(autoincrement())
  customerId Int
  total      Decimal         @db.Decimal(10, 2)
  balance    Decimal         @db.Decimal(10, 2)
  status     CreditStatus    @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  customer   Customer        @relation(fields: [customerId], references: [id])
  items      CreditItem[]
  payments   CreditPayment[]

  @@index([customerId, status])
  @@index([createdAt])
}

model CreditItem {
  id        Int     @id @default(autoincrement())
  creditId  Int
  productId Int
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  credit    Credit  @relation(fields: [creditId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

model CreditPayment {
  id        Int      @id @default(autoincrement())
  creditId  Int
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  credit    Credit   @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}
